{
  "name": "fight-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Fight Creator — przeglądarkowy edytor i silnik turowych walk z unikaniem pocisków (bullet box).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:sprites": "node tools/gen-sprites.mjs",
    "gen:font": "node tools/gen-font.cjs"
  },
  "devDependencies": {
    "@fontsource/jersey-10": "^5.2.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
